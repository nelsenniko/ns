  <script>
    // ============ SWEETALERT PRO ============
    const SwalPro = Swal.mixin({
      customClass: {
        popup: 'swal-pro',
        title: 'swal-title-pro',
        htmlContainer: 'swal-html-pro',
        confirmButton: 'swal-btn-confirm',
        cancelButton: 'swal-btn-cancel'
      },
      buttonsStyling: false,
      reverseButtons: true,
      focusConfirm: false
    });

    // ============ KONFIGURASI LAYANAN ============
    const SERVICES = {
      'voucher-listrik': {
        label: 'Voucher Listrik',
        icon: 'fa-bolt',
        color: '#fbbf24',
        selectedEl: 'selected-voucher',
        nameId: 'voucher-name',
        idField: { id: 'voucher-id', label: 'ID Meter', icon: 'fa-id-card' },
        mode: 'package',
        packageLabel: 'Token'
      },
      'pulsa': {
        label: 'Pulsa HP',
        icon: 'fa-mobile-screen-button',
        color: '#3b82f6',
        selectedEl: 'selected-pulsa',
        nameId: 'pulsa-name',
        idField: { id: 'pulsa-phone', label: 'Nomor HP', icon: 'fa-mobile-screen' },
        mode: 'package',
        packageLabel: 'Pulsa',
        extraField: {
          id: 'pulsa-operator',
          label: 'Operator',
          icon: 'fa-signal'
        }
      },
      'tagihan-listrik': {
        label: 'Tagihan Listrik',
        icon: 'fa-file-invoice-dollar',
        color: '#f97316',
        selectedEl: 'selected-tagihan',
        nameId: 'tagihan-name',
        idField: { id: 'tagihan-id', label: 'ID Pelanggan', icon: 'fa-hashtag' },
        mode: 'amount',
        amountId: 'tagihan-amount',
        amountLabel: 'Jumlah Tagihan'
      },
      'diamond-ff': {
        label: 'Diamond Free Fire',
        icon: 'fa-gem',
        color: '#ec4899',
        selectedEl: 'selected-ff',
        nameId: 'ff-name',
        idField: { id: 'ff-id', label: 'ID Game FF', icon: 'fa-id-badge' },
        mode: 'package',
        packageLabel: 'Diamond'
      }
    };

    // ============ NAVIGASI HALAMAN ============
    function showPage(pageId) {
      document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
      const target = document.getElementById('page-' + pageId);
      if (target) {
        target.classList.add('active');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    // Klik menu utama
    document.querySelectorAll('.menu-card').forEach(card => {
      card.addEventListener('click', () => {
        showPage(card.dataset.page);
      });
    });

    // Tombol back
    document.querySelectorAll('[data-back]').forEach(btn => {
      btn.addEventListener('click', () => showPage('home'));
    });

    // ============ STATE PER HALAMAN ============
    const state = {
      'voucher-listrik': { price: null, item: null, activePackage: null },
      'pulsa': { price: null, item: null, activePackage: null },
      'tagihan-listrik': { price: null, item: null, activePackage: null },
      'diamond-ff': { price: null, item: null, activePackage: null }
    };

    // ============ FORMAT RUPIAH ============
    const formatRupiah = (n) => "Rp" + Number(n).toLocaleString("id-ID");

    // ============ ESCAPE HTML ============
    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, m => ({
        '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
      }[m]));
    }

    // ============ BIND PACKAGE PER HALAMAN ============
    Object.entries(SERVICES).forEach(([serviceKey, cfg]) => {
      if (cfg.mode !== 'package') return;

      const page = document.getElementById('page-' + serviceKey);
      const packages = page.querySelectorAll('.package');
      const selectedBox = document.getElementById(cfg.selectedEl);

      packages.forEach(pkg => {
        pkg.addEventListener('click', () => {
          const wasActive = pkg.classList.contains('active');
          packages.forEach(item => item.classList.remove('active'));
          pkg.classList.add('active');

          const price = pkg.dataset.price;
          const itemText = pkg.dataset.dm;

          state[serviceKey].price = price;
          state[serviceKey].item = itemText;
          state[serviceKey].activePackage = pkg;

          selectedBox.classList.add('has-value');
          selectedBox.innerHTML =
            `<i class="fa-solid fa-circle-check" style="color:#10b981"></i>
             <span>Dipilih: <b>${formatRupiah(price)}</b> • <b>${escapeHtml(itemText)}</b></span>`;

          if (!wasActive) {
            SwalPro.fire({
              icon: 'success',
              title: 'Paket Dipilih',
              html: `Kamu memilih <strong>${escapeHtml(itemText)}</strong> seharga <strong>${formatRupiah(price)}</strong>`,
              timer: 1600,
              timerProgressBar: true,
              showConfirmButton: false,
              width: 380
            });
          }
        });
      });
    });

    // ============ INPUT TAGIHAN (jumlah) ============
    const tagihanAmount = document.getElementById('tagihan-amount');
    const selectedTagihan = document.getElementById('selected-tagihan');
    tagihanAmount.addEventListener('input', (e) => {
      // hanya angka
      e.target.value = e.target.value.replace(/\D/g, '');

      const val = e.target.value;
      if (val && Number(val) > 0) {
        state['tagihan-listrik'].price = val;
        selectedTagihan.classList.add('has-value');
        selectedTagihan.innerHTML =
          `<i class="fa-solid fa-circle-check" style="color:#10b981"></i>
           <span>Jumlah tagihan: <b>${formatRupiah(val)}</b></span>`;
      } else {
        state['tagihan-listrik'].price = null;
        selectedTagihan.classList.remove('has-value');
        selectedTagihan.innerHTML =
          `<i class="fa-solid fa-circle-info"></i>
           <span>Isi form di atas untuk membayar tagihan</span>`;
      }
    });

    // ============ HILANGKAN ERROR SAAT INPUT ============
    document.querySelectorAll('input, select').forEach(inp => {
      inp.addEventListener('input', () => inp.classList.remove('error'));
      inp.addEventListener('change', () => inp.classList.remove('error'));
    });

    // ============ SHOW ERROR ============
    function showError(title, text, focusEl) {
      SwalPro.fire({
        icon: 'error',
        title: title,
        html: text,
        confirmButtonText: '<i class="fa-solid fa-rotate-right"></i> Coba Lagi',
        width: 380
      }).then(() => {
        if (focusEl) {
          focusEl.focus();
          focusEl.classList.add('error');
        }
      });
    }

    // ============ PROSES PEMBELIAN ============
    async function buyNow(serviceKey) {
      const cfg = SERVICES[serviceKey];
      const st = state[serviceKey];

      const nameInput = document.getElementById(cfg.nameId);
      const idInput = document.getElementById(cfg.idField.id);

      const buyerName = nameInput.value.trim();
      const idValue = idInput.value.trim();

      // 1) Cek paket / jumlah
      if (!st.price) {
        const msg = cfg.mode === 'amount'
          ? 'Silakan isi <strong>jumlah tagihan</strong> terlebih dahulu.'
          : 'Silakan pilih <strong>paket</strong> terlebih dahulu.';
        return SwalPro.fire({
          icon: 'info',
          title: 'Belum Lengkap',
          html: msg,
          confirmButtonText: '<i class="fa-solid fa-check"></i> Oke',
          width: 380
        });
      }

      // 2) Cek nama
      if (!buyerName) {
        return showError('Nama Kosong',
          'Silakan masukkan <strong>nama pembeli</strong> terlebih dahulu.',
          nameInput);
      }
      if (buyerName.length < 3) {
        return showError('Nama Terlalu Pendek',
          'Nama minimal <strong>3 karakter</strong>.',
          nameInput);
      }

      // 3) Cek ID
      if (!idValue) {
        return showError(
          cfg.idField.label + ' Kosong',
          `Silakan masukkan <strong>${cfg.idField.label}</strong> terlebih dahulu.`,
          idInput
        );
      }

      // Validasi khusus
      if (serviceKey === 'pulsa') {
        if (!/^0\d{8,13}$/.test(idValue)) {
          return showError('Nomor HP Tidak Valid',
            'Nomor HP harus diawali <strong>0</strong> dan berisi <strong>9–14 digit</strong>.',
            idInput);
        }
        const op = document.getElementById('pulsa-operator');
        if (!op.value) {
          return showError('Operator Belum Dipilih',
            'Silakan pilih <strong>operator</strong> terlebih dahulu.',
            op);
        }
      } else if (serviceKey === 'tagihan-listrik' || serviceKey === 'voucher-listrik') {
        if (!/^\d{6,20}$/.test(idValue)) {
          return showError(cfg.idField.label + ' Tidak Valid',
            `${cfg.idField.label} harus berupa <strong>angka 6–20 digit</strong>.`,
            idInput);
        }
      } else if (serviceKey === 'diamond-ff') {
        if (!/^\d{6,20}$/.test(idValue)) {
          return showError('ID Game Tidak Valid',
            'ID Game harus berupa <strong>angka 6–20 digit</strong>.',
            idInput);
        }
      }

      const price = formatRupiah(st.price);

      // 4) Bangun detail rows
      let detailRows = `
        <div class="k"><i class="fa-solid fa-box"></i> Layanan</div>
        <div class="v">${escapeHtml(cfg.label)}</div>
        <div class="k"><i class="fa-solid fa-user"></i> Nama</div>
        <div class="v">${escapeHtml(buyerName)}</div>
        <div class="k"><i class="fa-solid ${cfg.idField.icon}"></i> ${escapeHtml(cfg.idField.label)}</div>
        <div class="v">${escapeHtml(idValue)}</div>
      `;

      if (serviceKey === 'pulsa') {
        const op = document.getElementById('pulsa-operator');
        detailRows += `
          <div class="k"><i class="fa-solid fa-signal"></i> Operator</div>
          <div class="v">${escapeHtml(op.value)}</div>
        `;
      }

      if (cfg.mode === 'amount') {
        detailRows += `
          <div class="k"><i class="fa-solid fa-coins"></i> ${escapeHtml(cfg.amountLabel)}</div>
          <div class="v price">${price}</div>
        `;
      } else {
        detailRows += `
          <div class="k"><i class="fa-solid fa-cube"></i> ${escapeHtml(cfg.packageLabel)}</div>
          <div class="v">${escapeHtml(st.item)}</div>
          <div class="k"><i class="fa-solid fa-tag"></i> Harga</div>
          <div class="v price">${price}</div>
        `;
      }

      // 5) Konfirmasi
      const confirm = await SwalPro.fire({
        icon: 'question',
        title: 'Konfirmasi Pesanan',
        html: `
          <div>Periksa kembali detail pesanan kamu:</div>
          <div class="swal-detail">${detailRows}</div>
        `,
        showCancelButton: true,
        confirmButtonText: '<i class="fa-brands fa-whatsapp"></i> Kirim ke WhatsApp',
        cancelButtonText: 'Batal',
        width: 420,
        didOpen: () => {
          const btn = Swal.getConfirmButton();
          if (btn) btn.classList.add('swal-btn-wa');
        }
      });

      if (!confirm.isConfirmed) {
        return SwalPro.fire({
          icon: 'info',
          title: 'Dibatalkan',
          html: 'Pesanan tidak dikirim.',
          timer: 1500,
          timerProgressBar: true,
          showConfirmButton: false,
          width: 360
        });
      }

      // 6) Susun pesan WhatsApp
      let message =
`🛒 *NELSEN STORE*

━━━━━━━━━━━━━━━━━━
Layanan : ${cfg.label}
Nama    : ${buyerName}`;

      if (serviceKey === 'pulsa') {
        message += `\nOperator: ${document.getElementById('pulsa-operator').value}`;
      }

      message += `\n${cfg.idField.label}: ${idValue}`;

      if (cfg.mode === 'amount') {
        message += `\n${cfg.amountLabel}: ${price}`;
      } else {
        message += `\n${cfg.packageLabel}: ${st.item}`;
        message += `\nHarga   : ${price}`;
      }

      message += `\n━━━━━━━━━━━━━━━━━━\n\nTerima kasih 🙏`;

      const whatsappNumber = "6285328736706";
      const url = "https://wa.me/" + whatsappNumber + "?text=" + encodeURIComponent(message);

      // 7) Loading + buka WhatsApp
      SwalPro.fire({
        title: 'Mengarahkan ke WhatsApp...',
        html: 'Mohon tunggu sebentar 🙏',
        allowOutsideClick: false,
        allowEscapeKey: false,
        showConfirmButton: false,
        width: 340,
        didOpen: () => Swal.showLoading()
      });

      setTimeout(() => {
        window.open(url, "_blank");
        Swal.close();

        SwalPro.fire({
          icon: 'success',
          title: 'Berhasil!',
          html: `Pesanan <strong>${escapeHtml(cfg.label)}</strong> telah dikirim ke WhatsApp.<br>Terima kasih, <strong>${escapeHtml(buyerName)}</strong>! 🎉`,
          confirmButtonText: '<i class="fa-solid fa-check"></i> Selesai',
          width: 380
        });
      }, 900);
    }
  </script>

</body>
